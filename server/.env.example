# Comma-separated frontend origins; localhost origins are allowed outside production.
CORS_ORIGINS=https://humagainrabin.com.np

# PostgreSQL connection string used by Prisma; never commit the real value.
# DATABASE_URL=

# For a direct Render Web Service (Cloudflare R2 only), set this in Render's environment.
# Recalculate if another proxy is placed in front of the API.
# TRUST_PROXY_HOPS=1

# High-entropy secret for signing administrator JWTs.
# JWT_SECRET=

# High-entropy, one-time key required to create the first administrator.
# Use at least 32 random bytes; never use this value in frontend configuration.
# ADMIN_SETUP_KEY=

# Required in production for Cloudflare R2-backed uploads.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Required for administrator password-reset email delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
